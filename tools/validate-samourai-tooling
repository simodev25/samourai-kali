#!/usr/bin/env python3
"""Validate Samourai agent/skill/command Kali tooling contracts."""

from pathlib import Path
import sys


ROOT = Path(".")

WORKFLOW = [
    ("recon", "attack-surface-agent"),
    ("hunt", "bug-hunting-agent"),
    ("analyze-vuln", "vulnerability-analysis-agent"),
    ("cve-lookup", "cve-intelligence-agent"),
    ("poc", "safe-poc-agent"),
    ("cve-report", "cve-report-agent"),
]


def parse_frontmatter(path: Path):
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---\n", 4)
    if end == -1:
        return None
    data = {}
    for raw in text[4:end].splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        key, value = line.split(":", 1)
        data[key.strip()] = value.strip()
    return data


def require_contains(errors, path: Path, markers):
    text = path.read_text(encoding="utf-8")
    for marker in markers:
        if marker not in text:
            errors.append(f"{path}: missing marker {marker!r}")


def validate_agents(errors):
    files = sorted((ROOT / "core/agents").glob("*.md"))
    if not files:
        errors.append("core/agents: no agent files found")
        return
    for path in files:
        require_contains(
            errors,
            path,
            ["## Kali Tools Used", "## Command Examples", "## Expected Output"],
        )


def validate_skills(errors):
    files = sorted((ROOT / "core/skills").glob("*/SKILL.md"))
    if not files:
        errors.append("core/skills: no skill files found")
        return
    for path in files:
        require_contains(
            errors,
            path,
            ["## Tools Used", "## Command Examples", "## Result Interpretation"],
        )


def validate_commands(errors):
    files = sorted((ROOT / "core/commands").glob("*.md"))
    if not files:
        errors.append("core/commands: no command files found")
        return
    for path in files:
        fm = parse_frontmatter(path)
        if fm is None:
            errors.append(f"{path}: missing or malformed front matter")
            continue
        if not fm.get("description"):
            errors.append(f"{path}: missing description")
        if not fm.get("agent"):
            errors.append(f"{path}: missing agent")
        if fm.get("subtask") not in {"true", "false"}:
            errors.append(f"{path}: subtask must be boolean true|false")
        require_contains(
            errors,
            path,
            [
                "<kali_execution_context>",
                "<tools>",
                "<preflight>",
                "<command_examples>",
                "<structured_output>",
            ],
        )


def validate_workflow(errors):
    for command, expected_agent in WORKFLOW:
        path = ROOT / "core/commands" / f"{command}.md"
        if not path.exists():
            errors.append(f"workflow: missing /{command} command")
            continue
        fm = parse_frontmatter(path) or {}
        actual_agent = fm.get("agent")
        if actual_agent != expected_agent:
            errors.append(
                f"workflow /{command}: expected agent {expected_agent}, got {actual_agent or 'none'}"
            )
        text = path.read_text(encoding="utf-8")
        if "evidence_paths" not in text:
            errors.append(f"workflow /{command}: output contract lacks evidence_paths")
        if "missing_tools" not in text:
            errors.append(f"workflow /{command}: output contract lacks missing_tools")


def main():
    errors = []
    validate_agents(errors)
    validate_skills(errors)
    validate_commands(errors)
    validate_workflow(errors)

    if errors:
        print("Samourai tooling validation FAILED:")
        for error in errors:
            print(f"- {error}")
        return 1

    print("Samourai tooling validation PASSED")
    print("Agents, skills, command prompts, and workflow contracts are present.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
