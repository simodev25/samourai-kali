{
  "inputs": [
    {
      "type": "promptString",
      "id": "github_token",
      "description": "GitHub token for workspace MCP access",
      "password": true
    },
    {
      "type": "promptString",
      "id": "nvd_api_key",
      "description": "Optional NVD API key (NVD_API_KEY)",
      "password": true
    }
  ],
  "servers": {
    "github": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_token}"
      }
    },
    "nvd-epss": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "env": {
        "NVD_API_KEY": "${input:nvd_api_key}",
        "NVD_BASE_URL": "https://services.nvd.nist.gov/rest/json",
        "EPSS_BASE_URL": "https://api.first.org/data/v1/epss"
      }
    }
  }
}
